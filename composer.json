{
    "name": "joranski/agents",
    "version": "3.0.0",
    "description": "Lean portable agent skills, universal engineering rules, and an idempotent sync (bin/sync-agents) for Laravel + Livewire + FluxUI projects, plus git:pull, git:push, and Night Shift.",
    "keywords": ["laravel", "agents", "deploy", "git", "ai", "fluxui", "livewire", "skills"],
    "license": "MIT",
    "authors": [
        {
            "name": "James Oranski",
            "email": "joranski@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/process": "^12.0 || ^13.0",
        "laravel/prompts": "^0.1 || ^0.2 || ^0.3",
        "laravel/boost": "^2.0",
        "laravel/mcp": "^0.5 || ^0.6 || ^0.7",
        "laravel/pint": "^1.0"
    },
    "bin": ["bin/sync-agents"],
    "autoload": {
        "psr-4": {
            "Joranski\\Agents\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joranski\\Agents\\AgentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
